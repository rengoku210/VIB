# VIB Platform Environment Configuration Template

# Server Port
PORT=5000

# Client Configuration
VITE_API_URL=http://localhost:5000

# Firebase Authentication (Google OAuth & Password Recovery)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Valorant / Riot Games Account Verification API
# (Optional: If omitted, built-in structural heuristics and pre-seeded database registry are used)
RIOT_API_KEY=RGAPI-your-riot-api-key-here
HENRIK_API_KEY=your-henrikdev-api-key-here

